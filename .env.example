# =========================================================================
# STATE EMERGENCY OPERATIONS CENTRE (SEOC) - ENVIRONMENT CONFIGURATION
# =========================================================================

# Application
APP_NAME="SEOC Disaster Severity & Resource Allocation Platform"
APP_ENV="development"
PORT=8000
DEBUG=True

# Database (PostgreSQL + PostGIS / SQLite fallback for local test)
DATABASE_URL="sqlite:///./seoc_disaster.db"
# Production PostGIS URL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seoc_disaster_db"

# Security & Authentication
SECRET_KEY="seoc-telangana-super-secure-jwt-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# External Telemetry API Endpoints (Set to MOCK in simulation mode)
IMD_WEATHER_API_URL="https://api.imd.gov.in/v1/weather/hyderabad"
IMD_API_KEY="mock-or-actual-key"
CWC_RIVER_GAUGE_API_URL="https://cwc.gov.in/musi-telemetry"

# LLM & RAG Provider (Default: Local / Embeddings or OpenAI / Anthropic)
LLM_PROVIDER="local-grounded-rag"
OPENAI_API_KEY=""

# Redis Cache (Optional streaming/pubsub)
REDIS_URL="redis://localhost:6379/0"
